# ==============================================================================
# NEXUS AI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=nexus_user
DATABASE_PASSWORD=nexus_password
DATABASE_NAME=nexus_db
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_LOGGING=true
DATABASE_POOL_SIZE=20

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@nexus.ai
PGADMIN_DEFAULT_PASSWORD=admin_password
PGADMIN_PORT=5050

# Authentication & Security
JWT_SECRET=super_secret_jwt_access_token_key_nexus_ai_2026
JWT_EXPIRATION=900
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_nexus_ai_2026
JWT_REFRESH_EXPIRATION=604800

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# External Integration - Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash

# External Integration - Cloudinary CDN
CLOUDINARY_CLOUD_NAME=nexus_cloudinary_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# External Integration - Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=nexus-ai-firebase
FCM_CLIENT_EMAIL=firebase-adminsdk@nexus-ai.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nplaceholder\n-----END PRIVATE KEY-----"

# External Integration - Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
